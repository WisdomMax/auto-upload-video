# Buffer API Settings
BUFFER_ACCESS_TOKEN=your_buffer_access_token_here

# Cloudflare R2 Settings (동영상 업로드용)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_BUCKET_NAME=blog
CLOUDFLARE_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# AI Content Generation Settings (선택 사항)
GEMINI_API_KEY=your_gemini_api_key_here

# Coupang Partners API Settings (선택 사항)
COUPANG_ACCESS_KEY=your_coupang_access_key_here
COUPANG_SECRET_KEY=your_coupang_secret_key_here

# ManyChat API Settings (선택 사항)
MANYCHAT_API_TOKEN=your_manychat_api_token_here

# YouTube API Settings (선택 사항)
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CHANNEL_ID=your_youtube_channel_id_here

# GitHub Automation Settings (정적 페이지 자동 git push 배포용)
GITHUB_TOKEN=your_github_personal_access_token_here
